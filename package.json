{
  "name": "sales-sustainability",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:api": "nodemon --exec \"npx tsx local-server.ts\" --watch local-server.ts --watch api --ext ts --ignore api/db --delay 1500",
    "build": "ng build",
    "vercel-build": "ng build --configuration production && npm run optimize-css",
    "optimize-css": "postcss dist/sales-sustainability/browser/**/*.css --replace --config postcss.config.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "vercel:dev": "vercel dev",
    "vercel:build": "vercel build",
    "vercel:deploy": "vercel --prod"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@langchain/core": "0.3.76",
    "@langchain/openai": "0.6.12",
    "@vercel/node": "^5.3.15",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "openai": "^5.16.0",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.6",
    "cssnano": "^7.1.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2"
  },
  "nodemonConfig": {
    "watch": [
      "local-server.ts",
      "api/**/*.ts"
    ],
    "ext": "ts",
    "exec": "tsx local-server.ts",
    "ignore": [
      "node_modules/**/*",
      "api/db/**/*"
    ],
    "delay": 500
  }
}
